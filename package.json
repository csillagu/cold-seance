{
  "name": "cold-seance",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces && tsc -p scripts",
    "test": "npm run test --workspaces",
    "test:unit": "npm run test:unit --workspaces",
    "test:coverage": "npm run test:coverage --workspaces",
    "test:integration": "npm run test:integration --workspace backend",
    "test:image": "npm run test:image --workspace backend",
    "build": "npm run build --workspaces",
    "db:check": "npm run db:check --workspace backend",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run db:check && npm run test:unit && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild": false
  }
}
