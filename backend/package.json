{
  "name": "@cold-seance/backend",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:image": "vitest run --project image",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:check": "node scripts/db-check.ts",
    "db:rebase": "node scripts/db-rebase.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "@fastify/swagger": "^9.9.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
