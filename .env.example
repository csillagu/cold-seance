# The settings of the Compose install (compose.yaml, SC-029). Copy this file to .env beside
# compose.yaml; .env holds a secret, so keep it readable by you only. The tool's own settings are in
# config.yaml (DD-059), apart from the database address, which is set here.

# The password of the bundled PostgreSQL. Required unless COLD_SEANCE_DATABASE_URL is set. It is
# used when the database volume is first created; changing it later does not change the
# database's password.
POSTGRES_PASSWORD=

# The PostgreSQL database the tool stores its data in, if not the bundled one: an existing or
# hosted PostgreSQL such as Neon (FR-177). Start only the application then, with
# `docker compose up -d --no-deps app`.
# COLD_SEANCE_DATABASE_URL=postgres://user:password@host:5432/database
# A direct (not pooled) connection to it, for the migrations; COLD_SEANCE_DATABASE_URL if not set.
# COLD_SEANCE_DATABASE_DIRECT_URL=postgres://user:password@direct-host:5432/database

# Where the tool is reached: an address and a port of this machine. 127.0.0.1:3000, this machine
# only, if not set; 0.0.0.0:3000 publishes it on every interface.
# COLD_SEANCE_PUBLISH=127.0.0.1:3000

# The application image; cold-seance, built from this repository, if not set.
# COLD_SEANCE_IMAGE=cold-seance
